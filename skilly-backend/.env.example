# Skilly Latam — Variables de entorno (plantilla)
# Copiar a .env y completar. NUNCA versionar el .env real.
# Ticket 0.2

# --- Entorno ---
DEBUG=1
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Base de datos MariaDB (ticket 0.3) ---
DB_ENGINE=django.db.backends.mysql
DB_NAME=skilly
DB_USER=skilly
DB_PASSWORD=cambia-esta-clave
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# --- Hosts y CORS (ticket 0.6) ---
# Lista blanca separada por comas. Nunca usar * con credenciales.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Almacenamiento S3 (ticket 0.7) ---
# Dejar USAR_S3=0 en desarrollo para escribir a disco en media/.
USAR_S3=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=skilly-uploads
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=auto
AWS_PRESIGNED_EXPIRE=900

# --- Correo (ticket 0.8) ---
# Consola en desarrollo; django_ses en produccion.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=contacto@skillylatam.com
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION_NAME=us-east-1

# --- JWT (ticket 0.17) ---
# Las ACCESS/REFRESH lives estan en config/settings.py (SIMPLE_JWT).

# --- Celery / Redis (Sprint 3) ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# --- Constantes de negocio (ticket 0.9) ---
PLAZO_RESPUESTA_PROFESIONAL_HORAS=6
PLAZO_RECORDATORIO_HORAS=4
PLAZO_REVISION_ORGANIZACION_DIAS=5
DIAS_VENTANA_AUTORIZACION_WEBPAY=7
TOKEN_MAGICO_HORAS=24
MONTO_MINIMO_SERVICIO=5000
TASA_COMISION_DEFECTO=0.10
HORAS_CANCELACION_SIN_PENALIDAD=24
PORCENTAJE_REEMBOLSO_CANCELACION_TARDIA=90

# --- Logging ---
LOG_LEVEL=INFO