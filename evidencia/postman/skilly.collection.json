    {
      "name": "CP-FUNC-04 - Slots disponibles",
      "request": {"method": "GET", "url": "{{base_url}}/servicios/{{servicio_id}}/slots/?fecha={{fecha}}"},
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
